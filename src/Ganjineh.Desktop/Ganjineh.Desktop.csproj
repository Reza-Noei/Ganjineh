<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ganjineh.Domain\Ganjineh.Domain.csproj" />
    <ProjectReference Include="..\Ganjineh.Application\Ganjineh.Application.csproj" />
    <ProjectReference Include="..\Ganjineh.Persistence\Ganjineh.Persistence.csproj" />
    <ProjectReference Include="..\Ganjineh.Infrastructure\Ganjineh.Infrastructure.csproj" />
    <ProjectReference Include="..\Ganjineh.Cryptography\Ganjineh.Cryptography.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Product exe name (installer + shortcuts expect Ganjineh.exe, not Ganjineh.Desktop.exe). -->
    <AssemblyName>Ganjineh</AssemblyName>
    <AssemblyTitle>Ganjineh</AssemblyTitle>
    <Product>Ganjineh</Product>
    <!-- Single source of release truth: CI reads this for tags, Velopack and MSI versioning. -->
    <Version>1.0.0</Version>
    <Authors>Reza Noei</Authors>
    <Description>Offline, Persian-first, multi-vault password manager for Windows.</Description>
    <!-- Velopack: VelopackApp hooks must run before any WPF overhead — custom Main below.
         App.xaml is compiled as a Page because the StartupObject is our own Main. -->
    <StartupObject>Ganjineh.Desktop.App</StartupObject>
    <!-- Shell + taskbar/window icon. -->
    <ApplicationIcon>Assets\Icons\ganjineh_E1_1000x1000.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

    <ItemGroup>
      <!-- Vendored Vazirmatn, SIL Open Font License 1.1 (Assets/Fonts/OFL.txt). -->
      <Resource Include="Assets\Fonts\Vazirmatn-Regular.ttf" />
      <Resource Include="Assets\Fonts\Vazirmatn-Medium.ttf" />
      <Resource Include="Assets\Fonts\Vazirmatn-SemiBold.ttf" />
      <!-- Brand: exe/window icon and product logo. -->
      <Resource Include="Assets\Icons\ganjineh_E1_1000x1000.ico" />
      <Resource Include="Assets\Images\ganjineh_E1_1000x1000.png" />
    </ItemGroup>
</Project>

