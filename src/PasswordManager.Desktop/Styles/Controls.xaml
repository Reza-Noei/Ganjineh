<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Material Design rebase: the implicit control styles come from MaterialDesign3.Defaults.xaml
         (merged before this dictionary in App.xaml). The styles here only add Ganjineh-specific
         sizing/typography on top, and reference theme tokens via DynamicResource so live theme
         swaps propagate. Note: no letter-spacing / uppercase styles anywhere — Persian script is
         cursive and caseless; both would visibly break text shaping. -->

    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline6TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody1TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignCaptionTextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignCaptionTextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Margin" Value="16,20,16,6" />
    </Style>

    <!-- Field-group label inside the details/editor cards. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="Margin" Value="0,12,0,3" />
    </Style>

    <!-- Technical values (passwords, URLs, emails, codes): LTR + monospace regardless of the
         shell flow direction, so bidi never scrambles Latin runs inside the RTL layout. -->
    <Style x:Key="LtrValueText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <!-- Implicit button: Material raised (primary action). -->
    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Destructive primary action (delete/purge): raised shape, danger color. -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Background" Value="{DynamicResource Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Quiet text button for the top bar and secondary actions (Material flat). -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Square icon-only button for per-field copy/reveal actions (tooltip carries the label). -->
    <Style x:Key="IconActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Navigation entry in the side column. A radio (not a button) so the active section shows
         a persistent tinted state; the template stretches so the label aligns to the leading
         edge in both RTL and LTR without hard-coded Left/Right. -->
    <Style x:Key="NavRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Item.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Accent.Soft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavRadioButtonItem" TargetType="RadioButton" BasedOn="{StaticResource NavRadioButton}">
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Quiet full-width flat button (nav entries that open overlays). -->
    <Style x:Key="NavItemButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Filter chip (security center finding kinds): checked = tinted + accent text. -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" CornerRadius="14" BorderBrush="{DynamicResource Divider}"
                            BorderThickness="1" Background="Transparent" Padding="11,4">
                        <ContentPresenter x:Name="Content" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Item.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Accent.Soft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Input fields on the implicit Material TextBox (filled, MD3). Character counters are
         disabled — they float into the following field's label in tight stacked forms. -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="materialDesign:TextFieldAssist.CharacterCounterVisibility" Value="Collapsed" />
    </Style>

    <!-- Password twin of SearchBoxStyle (TargetType must match exactly). -->
    <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="materialDesign:TextFieldAssist.CharacterCounterVisibility" Value="Collapsed" />
    </Style>

    <!-- Secondary emphasized action (outlined, MD3) — e.g. picker "open existing". -->
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <!-- Card surface: Ganjineh's Bg.Card token + hairline divider border (MD3 tone-card look,
         no heavy elevation shadows — "calm density" per ui-ux-specification.md §1). Bound to our
         own token rather than a Material brush key so the surface can never silently resolve null. -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bg.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Grouped section card inside the details pane / editor. -->
    <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Stat tile (security center counters). -->
    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
</ResourceDictionary>
