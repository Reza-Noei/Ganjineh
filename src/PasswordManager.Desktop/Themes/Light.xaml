<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme tokens, mapped to the Material palette (Grey surfaces, Blue primary).
         Keys must match Dark.xaml exactly. -->
    <Color x:Key="Bg.Base.Color">#F5F5F5</Color>              <!-- Material Grey 100 -->
    <Color x:Key="Bg.Card.Color">#FFFFFF</Color>
    <Color x:Key="Bg.Sunken.Color">#EEEEEE</Color>            <!-- Material Grey 200 -->
    <Color x:Key="Text.Primary.Color">#212121</Color>         <!-- Material Grey 900 -->
    <Color x:Key="Text.Secondary.Color">#757575</Color>       <!-- Material Grey 600 -->
    <Color x:Key="Accent.Color">#1976D2</Color>               <!-- Material Blue 700 -->
    <Color x:Key="Accent.Soft.Color">#E3F2FD</Color>          <!-- Material Blue 50 -->
    <Color x:Key="Danger.Color">#D32F2F</Color>               <!-- Material Red 700 -->
    <Color x:Key="Success.Color">#388E3C</Color>              <!-- Material Green 700 -->
    <Color x:Key="Warning.Color">#FF6F00</Color>              <!-- Material Amber 900 -->
    <Color x:Key="Divider.Color">#E0E0E0</Color>              <!-- Material Grey 300 -->

    <SolidColorBrush x:Key="Bg.Base" Color="{StaticResource Bg.Base.Color}" />
    <SolidColorBrush x:Key="Bg.Card" Color="{StaticResource Bg.Card.Color}" />
    <SolidColorBrush x:Key="Bg.Sunken" Color="{StaticResource Bg.Sunken.Color}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
    <SolidColorBrush x:Key="Accent.Soft" Color="{StaticResource Accent.Soft.Color}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource Success.Color}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource Warning.Color}" />
    <SolidColorBrush x:Key="Divider" Color="{StaticResource Divider.Color}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#1565C0" />   <!-- Material Blue 800 -->
    <SolidColorBrush x:Key="Item.Hover" Color="#0F000000" />
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#66000000" />
</ResourceDictionary>
