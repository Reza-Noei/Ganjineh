<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme tokens (ui-ux-specification.md §2). Keys must match Dark.xaml exactly. -->
    <Color x:Key="Bg.Base.Color">#F5F5F7</Color>
    <Color x:Key="Bg.Card.Color">#FFFFFF</Color>
    <Color x:Key="Bg.Sunken.Color">#ECECEF</Color>
    <Color x:Key="Text.Primary.Color">#1A1A1E</Color>
    <Color x:Key="Text.Secondary.Color">#5A5A66</Color>
    <Color x:Key="Accent.Color">#2F6FED</Color>
    <Color x:Key="Accent.Soft.Color">#E3ECFF</Color>
    <Color x:Key="Danger.Color">#C42B1C</Color>
    <Color x:Key="Success.Color">#0F7B3E</Color>
    <Color x:Key="Warning.Color">#9A6700</Color>
    <Color x:Key="Divider.Color">#E3E3E8</Color>

    <SolidColorBrush x:Key="Bg.Base" Color="{StaticResource Bg.Base.Color}" />
    <SolidColorBrush x:Key="Bg.Card" Color="{StaticResource Bg.Card.Color}" />
    <SolidColorBrush x:Key="Bg.Sunken" Color="{StaticResource Bg.Sunken.Color}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
    <SolidColorBrush x:Key="Accent.Soft" Color="{StaticResource Accent.Soft.Color}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource Success.Color}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource Warning.Color}" />
    <SolidColorBrush x:Key="Divider" Color="{StaticResource Divider.Color}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#2258C8" />
    <SolidColorBrush x:Key="Item.Hover" Color="#0000000A" />
</ResourceDictionary>
