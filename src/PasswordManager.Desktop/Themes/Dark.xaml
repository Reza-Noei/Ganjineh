<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme tokens, mapped to the Material dark palette. Keys must match Light.xaml exactly. -->
    <Color x:Key="Bg.Base.Color">#121212</Color>              <!-- Material dark surface -->
    <Color x:Key="Bg.Card.Color">#1E1E1E</Color>              <!-- Material dark elevated surface -->
    <Color x:Key="Bg.Sunken.Color">#161616</Color>
    <Color x:Key="Text.Primary.Color">#F5F5F5</Color>         <!-- Material Grey 50 -->
    <Color x:Key="Text.Secondary.Color">#BDBDBD</Color>       <!-- Material Grey 400 -->
    <Color x:Key="Accent.Color">#2196F3</Color>               <!-- Material Blue 500 -->
    <Color x:Key="Accent.Soft.Color">#0D2B45</Color>
    <Color x:Key="Danger.Color">#E57373</Color>               <!-- Material Red 300 -->
    <Color x:Key="Success.Color">#81C784</Color>              <!-- Material Green 300 -->
    <Color x:Key="Warning.Color">#FFB74D</Color>              <!-- Material Orange 300 -->
    <Color x:Key="Divider.Color">#424242</Color>              <!-- Material Grey 800 -->

    <SolidColorBrush x:Key="Bg.Base" Color="{StaticResource Bg.Base.Color}" />
    <SolidColorBrush x:Key="Bg.Card" Color="{StaticResource Bg.Card.Color}" />
    <SolidColorBrush x:Key="Bg.Sunken" Color="{StaticResource Bg.Sunken.Color}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
    <SolidColorBrush x:Key="Accent.Soft" Color="{StaticResource Accent.Soft.Color}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource Success.Color}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource Warning.Color}" />
    <SolidColorBrush x:Key="Divider" Color="{StaticResource Divider.Color}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#42A5F5" />   <!-- Material Blue 400 -->
    <SolidColorBrush x:Key="Item.Hover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Overlay.Scrim" Color="#99000000" />
</ResourceDictionary>
