<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme tokens (ui-ux-specification.md §2). Keys must match Light.xaml exactly. -->
    <Color x:Key="Bg.Base.Color">#1C1C1F</Color>
    <Color x:Key="Bg.Card.Color">#26262B</Color>
    <Color x:Key="Bg.Sunken.Color">#151518</Color>
    <Color x:Key="Text.Primary.Color">#F2F2F5</Color>
    <Color x:Key="Text.Secondary.Color">#A8A8B4</Color>
    <Color x:Key="Accent.Color">#6E9BFF</Color>
    <Color x:Key="Accent.Soft.Color">#1F335C</Color>
    <Color x:Key="Danger.Color">#FF99A4</Color>
    <Color x:Key="Success.Color">#6CCB5F</Color>
    <Color x:Key="Warning.Color">#E2B93B</Color>
    <Color x:Key="Divider.Color">#3A3A42</Color>

    <SolidColorBrush x:Key="Bg.Base" Color="{StaticResource Bg.Base.Color}" />
    <SolidColorBrush x:Key="Bg.Card" Color="{StaticResource Bg.Card.Color}" />
    <SolidColorBrush x:Key="Bg.Sunken" Color="{StaticResource Bg.Sunken.Color}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
    <SolidColorBrush x:Key="Accent.Soft" Color="{StaticResource Accent.Soft.Color}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource Success.Color}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource Warning.Color}" />
    <SolidColorBrush x:Key="Divider" Color="{StaticResource Divider.Color}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#8FB2FF" />
    <SolidColorBrush x:Key="Item.Hover" Color="#14FFFFFF" />
</ResourceDictionary>
