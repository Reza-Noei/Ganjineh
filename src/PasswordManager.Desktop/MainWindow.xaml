<Window x:Class="PasswordManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PasswordManager.Desktop.Localization"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:PasswordManager.Desktop.ViewModels"
        Title="{loc:Loc App.Title}"
        Width="1180" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Base}"
        FontFamily="{StaticResource App.FontFamily}"
        AutomationProperties.AutomationId="MainWindow"
        FlowDirection="{Binding ShellFlowDirection}">

    <Window.Resources>
        <DataTemplate x:Key="ItemTypeComboTemplate">
            <TextBlock Text="{Binding Converter={StaticResource TypeToLabel}}" />
        </DataTemplate>

        <!-- The shell is authored RTL-first: the FIRST grid column paints on the RIGHT.
             Spacing rule (FlowDirection cannot mirror physical margins): in stretch+auto column
             pairs the STRETCHING element carries symmetric horizontal margins ("12,0"), and in
             auto+auto rows every interactive sibling gets "4,0"/"8,0" — gaps stay identical in
             RTL and LTR, so no elements touch or overlap in either direction. -->

        <!-- ═══════════════ Vault picker ═══════════════ -->
        <DataTemplate DataType="{x:Type vm:VaultPickerViewModel}">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="420" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="14"
                                Background="{DynamicResource Accent.Soft}">
                            <materialDesign:PackIcon Kind="ShieldKey" Width="28" Height="28"
                                                     Foreground="{DynamicResource Accent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Picker.Title}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="8"
                        AutomationProperties.AutomationId="PickerList">
                    <Grid>
                        <ListBox ItemsSource="{Binding Vaults}" SelectedItem="{Binding SelectedVault}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.AutomationId="VaultList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10"
                                                Background="{DynamicResource Accent.Soft}">
                                            <materialDesign:PackIcon Kind="DatabaseOutline" Width="20" Height="20"
                                                                     Foreground="{DynamicResource Accent}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Medium"
                                                       Foreground="{DynamicResource Text.Primary}" />
                                            <TextBlock Text="{Binding Path}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Text.Secondary}" />
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Text.Secondary}">
                                                <Run Text="{loc:Loc Picker.LastOpened}" />
                                                <Run Text="{Binding LastOpenedAt, TargetNullValue=—}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{loc:Loc Picker.NoVaults}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryText}"
                                   Visibility="{Binding Vaults.Count, Converter={StaticResource ZeroToVisible}}" />
                    </Grid>
                </Border>

                <!-- Footer: one raised primary (unlock), one outlined create, quiet links. -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Command="{Binding CreateCommand}" Margin="8,0"
                            AutomationProperties.AutomationId="PickerCreate">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Picker.CreateVault}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Content="{loc:Loc Picker.OpenExisting}" Command="{Binding OpenExistingCommand}"
                            Style="{StaticResource OutlineButton}"
                            AutomationProperties.AutomationId="PickerOpenExisting" Margin="8,0" />
                    <Button Content="{loc:Loc Picker.RemoveFromList}" Command="{Binding RemoveFromListCommand}"
                            Style="{StaticResource IconButton}" AutomationProperties.AutomationId="PickerRemove"
                            Margin="8,0" />
                    <Button Content="{loc:Loc Picker.Unlock}" Command="{Binding UnlockCommand}"
                            AutomationProperties.AutomationId="PickerUnlock" IsDefault="True" Margin="24,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ═══════════════ Create vault wizard ═══════════════ -->
        <DataTemplate DataType="{x:Type vm:CreateVaultViewModel}">
            <Grid MaxWidth="640" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Step 1: details (hidden while the recovery stage is shown — both share Row 0) -->
                <StackPanel Grid.Row="0" AutomationProperties.AutomationId="CreateDetails"
                            Visibility="{Binding RecoveryStage, Converter={StaticResource FalseToVisible}}">
                    <TextBlock Text="{loc:Loc Create.Title}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,24" />
                    <TextBlock Text="{loc:Loc Create.NameLabel}" Style="{StaticResource BodyText}" />
                    <TextBox Text="{Binding VaultName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBoxStyle}" Margin="0,6,0,4"
                             AutomationProperties.AutomationId="CreateName" MaxLength="100" />
                    <TextBlock Text="{loc:Loc Create.NameHint}" Style="{StaticResource SecondaryText}" Margin="0,0,0,16" />

                    <TextBlock Text="{loc:Loc Create.LocationLabel}" Style="{StaticResource BodyText}" />
                    <Grid Margin="0,6,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBoxStyle}" IsReadOnly="True"
                                 AutomationProperties.AutomationId="CreateLocation" />
                        <Button Grid.Column="1" Content="{loc:Loc Create.Browse}" Style="{StaticResource IconButton}"
                                Command="{Binding BrowseCommand}" Margin="8,0"
                                AutomationProperties.AutomationId="CreateBrowse" VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Create.PasswordLabel}" Style="{StaticResource BodyText}" />
                            <PasswordBox x:Name="CreatePassword" Margin="0,6,0,12" Style="{StaticResource PasswordBoxStyle}"
                                         AutomationProperties.AutomationId="CreatePassword" MaxLength="1000" />
                            <TextBlock Text="{loc:Loc Create.ConfirmPasswordLabel}" Style="{StaticResource BodyText}" />
                            <PasswordBox x:Name="CreatePasswordConfirm" Margin="0,6,0,4" Style="{StaticResource PasswordBoxStyle}"
                                         AutomationProperties.AutomationId="CreatePasswordConfirm" MaxLength="1000" />
                            <TextBlock x:Name="StrengthText" Text="{Binding StrengthHint}" Style="{StaticResource SecondaryText}"
                                       Margin="0,4,0,0" AutomationProperties.AutomationId="StrengthHint" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 2: recovery key -->
                <StackPanel Grid.Row="0" Visibility="{Binding RecoveryStage, Converter={StaticResource BoolToVisible}}"
                            AutomationProperties.AutomationId="RecoveryStage">
                    <TextBlock Text="{loc:Loc Create.RecoveryTitle}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,16" />
                    <TextBlock Text="{loc:Loc Create.RecoveryExplain}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" Margin="0,0,0,16" />
                    <Border Style="{StaticResource CardBorder}" Padding="16" Background="{DynamicResource Bg.Sunken}">
                        <TextBlock Text="{Binding RecoveryKey}" FontSize="16" FontWeight="Medium" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Style="{StaticResource LtrValueText}" TextAlignment="Center"
                                   AutomationProperties.AutomationId="RecoveryKeyText" />
                    </Border>
                    <Button Content="{loc:Loc Create.RecoveryCopy}" Style="{StaticResource IconButton}"
                            HorizontalAlignment="Center" Margin="0,10,0,0"
                            Click="OnCopyRecoveryKeyClick" AutomationProperties.AutomationId="RecoveryCopy" />
                    <TextBlock Text="{Binding ChallengePrompt}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" Margin="0,20,0,4"
                               AutomationProperties.AutomationId="RecoveryChallengePrompt" />
                    <TextBox Text="{Binding ChallengeInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBoxStyle}" MaxLength="8"
                             AutomationProperties.AutomationId="RecoveryChallengeInput" />
                    <TextBlock Text="{Binding ChallengeError}" Foreground="{DynamicResource Danger}"
                               Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}"
                               Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{loc:Loc Create.Working}" Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                    <Button Content="{loc:Loc Create.Back}" Style="{StaticResource IconButton}"
                            Command="{Binding CancelCommand}" Margin="8,0" />
                    <Button Content="{loc:Loc Create.Next}" Command="{Binding CreateCommand}" IsDefault="True"
                            Click="OnCreateNextClick"
                            AutomationProperties.AutomationId="CreateNext"
                            Visibility="{Binding RecoveryStage, Converter={StaticResource FalseToVisible}}" />
                    <Button Content="{loc:Loc Create.RecoveryConfirm}" Command="{Binding ConfirmRecoverySavedCommand}"
                            IsDefault="True" AutomationProperties.AutomationId="RecoveryConfirm"
                            Visibility="{Binding RecoveryStage, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ═══════════════ Unlock ═══════════════ -->
        <DataTemplate DataType="{x:Type vm:UnlockViewModel}">
            <Grid MaxWidth="480" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="52" Height="52" CornerRadius="14"
                                Background="{DynamicResource Accent.Soft}">
                            <materialDesign:PackIcon Kind="LockOpenOutline" Width="28" Height="28"
                                                     Foreground="{DynamicResource Accent}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding VaultDisplayName}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"
                               AutomationProperties.AutomationId="UnlockVaultName" />
                    <TextBlock Text="{Binding VaultPath}" Style="{StaticResource SecondaryText}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,24" />

                    <StackPanel Visibility="{Binding RecoveryMode, Converter={StaticResource FalseToVisible}}"
                                AutomationProperties.AutomationId="UnlockPasswordPane">
                        <TextBlock Text="{loc:Loc Create.PasswordLabel}" Style="{StaticResource BodyText}" />
                        <PasswordBox x:Name="UnlockPassword" Margin="0,6,0,4" Style="{StaticResource PasswordBoxStyle}"
                                     AutomationProperties.AutomationId="UnlockPasswordBox" MaxLength="1000"
                                     KeyDown="OnUnlockPasswordKeyDown" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding RecoveryMode, Converter={StaticResource BoolToVisible}}"
                                AutomationProperties.AutomationId="UnlockRecoveryPane">
                        <TextBlock Text="{loc:Loc Unlock.RecoveryLabel}" Style="{StaticResource BodyText}" />
                        <TextBox Text="{Binding RecoveryKey, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBoxStyle}" Margin="0,6,0,0"
                                 AutomationProperties.AutomationId="UnlockRecoveryInput" />
                    </StackPanel>

                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}"
                               Style="{StaticResource SecondaryText}" Margin="0,12,0,0" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="UnlockError" />
                    <TextBlock Text="{loc:Loc Unlock.Working}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"
                               AutomationProperties.AutomationId="UnlockBusy" />

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="{loc:Loc Picker.Cancel}" Style="{StaticResource IconButton}"
                                Command="{Binding BackCommand}" Margin="8,0" />
                        <Button Content="{loc:Loc Unlock.UseRecovery}" Style="{StaticResource IconButton}"
                                Command="{Binding ToggleRecoveryModeCommand}" Margin="10,0"
                                AutomationProperties.AutomationId="ToggleRecoveryMode" />
                        <Button Command="{Binding UnlockWithRecoveryCommand}" IsDefault="True" Margin="24,0"
                                AutomationProperties.AutomationId="UnlockConfirmRecovery"
                                Visibility="{Binding RecoveryMode, Converter={StaticResource BoolToVisible}}">
                            <Button.Content>
                                <TextBlock Text="{loc:Loc Unlock.Unlock}" />
                            </Button.Content>
                        </Button>
                        <Button Command="{Binding UnlockCommand}" IsDefault="True" Margin="24,0"
                                AutomationProperties.AutomationId="UnlockButton"
                                Visibility="{Binding RecoveryMode, Converter={StaticResource FalseToVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LockOpenOutline" Width="18" Height="18"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Unlock.Unlock}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ═══════════════ Workspace (three-column) ═══════════════ -->
        <DataTemplate DataType="{x:Type vm:VaultWorkspaceViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- Top bar: brand + vault name / theme, language, lock -->
                <Border Grid.Row="0" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Divider}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Accent}">
                                <TextBlock Text="گ" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding VaultDisplayName}" Style="{StaticResource SubtitleText}"
                                       Margin="12,0" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="WorkspaceVaultName" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconActionButton}" Margin="4,0"
                                    Command="{Binding DataContext.ToggleThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{loc:Loc Top.ToggleTheme}"
                                    AutomationProperties.Name="{loc:Loc Top.ToggleTheme}"
                                    AutomationProperties.AutomationId="ToggleThemeButton">
                                <materialDesign:PackIcon Width="18" Height="18">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="WeatherNight" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.ThemeIsDark, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="True">
                                                    <Setter Property="Kind" Value="WeatherSunny" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                            <Button Style="{StaticResource IconActionButton}" Margin="4,0"
                                    Command="{Binding DataContext.ToggleLanguageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="{loc:Loc Top.ToggleLanguage}"
                                    AutomationProperties.Name="{loc:Loc Top.ToggleLanguage}"
                                    AutomationProperties.AutomationId="ToggleLanguageButton">
                                <materialDesign:PackIcon Kind="Translate" Width="18" Height="18" />
                            </Button>
                            <Button Command="{Binding LockCommand}" Margin="10,0"
                                    AutomationProperties.AutomationId="LockVaultButton">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Lock" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc Top.Lock}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Three columns: nav (right) / list (center) / details (left) in RTL.
                     The stretching CENTER border carries the symmetric 10px gutters; the outer
                     borders carry none, so gaps are identical in RTL and LTR. -->
                <Grid Grid.Row="1" Margin="10,8,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- ══ Navigation sidebar ══ -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="NavScroller">
                            <StackPanel>
                                <!-- Vault block -->
                                <Grid Margin="12,12,12,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="30" Height="30" CornerRadius="8"
                                                Background="{DynamicResource Accent.Soft}">
                                            <materialDesign:PackIcon Kind="ShieldKey" Width="17" Height="17"
                                                                     Foreground="{DynamicResource Accent}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding VaultDisplayName}" FontSize="14" FontWeight="Medium"
                                                   Foreground="{DynamicResource Text.Primary}" Margin="10,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="150" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource IconActionButton}"
                                            Command="{Binding LockCommand}"
                                            ToolTip="{loc:Loc Main.SwitchVault}"
                                            AutomationProperties.Name="{loc:Loc Main.SwitchVault}"
                                            AutomationProperties.AutomationId="SwitchVaultButton">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="17" Height="17" />
                                    </Button>
                                </Grid>
                                <Separator Margin="12,6" Background="{DynamicResource Divider}" />

                                <TextBlock Text="{loc:Loc Nav.Section.Vault}" Style="{StaticResource SectionHeader}" />
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="All"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=All}"
                                             AutomationProperties.AutomationId="NavAllItems">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Nav.AllItems}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Favorites"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Favorites}"
                                             AutomationProperties.AutomationId="NavFavorites">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Star" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Nav.Favorites}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Type:Login"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Type:Login}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Key" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Type.Login}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Type:SecureNote"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Type:SecureNote}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="NoteText" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Type.Note}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Type:PaymentCard"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Type:PaymentCard}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CreditCard" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Type.Card}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Type:Identity"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Type:Identity}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CardAccountDetails" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Type.Identity}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Type:Wifi"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Type:Wifi}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Wifi" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Type.Wifi}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Type:ApiCredential"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Type:ApiCredential}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Api" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Type.Api}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Type:SoftwareLicense"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Type:SoftwareLicense}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Certificate" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Type.License}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Type:RecoveryCodes"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Type:RecoveryCodes}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Dialpad" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Type.Codes}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Folders -->
                                <TextBlock Text="{loc:Loc Nav.Folders}" Style="{StaticResource SectionHeader}" />
                                <Grid Margin="14,0,14,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchBoxStyle}" MinWidth="0"
                                             Margin="8,0" MaxLength="100"
                                             AutomationProperties.AutomationId="NewFolderInput" />
                                    <Button Grid.Column="1" Style="{StaticResource IconActionButton}" Margin="4,0"
                                            Command="{Binding AddFolderCommand}"
                                            ToolTip="{loc:Loc Nav.AddFolder}"
                                            AutomationProperties.Name="{loc:Loc Nav.AddFolder}"
                                            AutomationProperties.AutomationId="AddFolderButton">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" />
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource IconActionButton}"
                                            Command="{Binding DeleteFolderCommand}"
                                            ToolTip="{loc:Loc Nav.DeleteFolder}"
                                            AutomationProperties.Name="{loc:Loc Nav.DeleteFolder}"
                                            AutomationProperties.AutomationId="DeleteFolderButton">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                                <ListBox ItemsSource="{Binding FolderNav}" SelectedItem="{Binding SelectedFolderNav}"
                                         Background="Transparent" BorderThickness="0" MinHeight="28"
                                         Margin="4,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.AutomationId="FolderList">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                                <materialDesign:PackIcon Kind="FolderOutline" Width="16" Height="16"
                                                                         Foreground="{DynamicResource Text.Secondary}"
                                                                         VerticalAlignment="Center" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text="{Binding Count, Mode=OneWay, StringFormat=({0})}" Foreground="{DynamicResource Text.Secondary}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Tags -->
                                <TextBlock Text="{loc:Loc Nav.Tags}" Style="{StaticResource SectionHeader}" />
                                <Grid Margin="14,0,14,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchBoxStyle}" MinWidth="0"
                                             Margin="8,0" MaxLength="60"
                                             AutomationProperties.AutomationId="NewTagInput" />
                                    <Button Grid.Column="1" Style="{StaticResource IconActionButton}" Margin="4,0"
                                            Command="{Binding AddTagCommand}"
                                            ToolTip="{loc:Loc Nav.AddTag}"
                                            AutomationProperties.Name="{loc:Loc Nav.AddTag}"
                                            AutomationProperties.AutomationId="AddTagButton">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" />
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource IconActionButton}"
                                            Command="{Binding DeleteTagCommand}"
                                            ToolTip="{loc:Loc Nav.DeleteTag}"
                                            AutomationProperties.Name="{loc:Loc Nav.DeleteTag}"
                                            AutomationProperties.AutomationId="DeleteTagButton">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                                <ListBox ItemsSource="{Binding TagNav}" SelectedItem="{Binding SelectedTagNav}"
                                         Background="Transparent" BorderThickness="0" MinHeight="28"
                                         Margin="4,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.AutomationId="TagList">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                                <materialDesign:PackIcon Kind="TagOutline" Width="16" Height="16"
                                                                         Foreground="{DynamicResource Text.Secondary}"
                                                                         VerticalAlignment="Center" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                    <Run Text="{Binding Count, Mode=OneWay, StringFormat=({0})}" Foreground="{DynamicResource Text.Secondary}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Tools -->
                                <TextBlock Text="{loc:Loc Nav.Section.Tools}" Style="{StaticResource SectionHeader}" />
                                <Button Style="{StaticResource NavItemButton}"
                                        Command="{Binding OpenGeneratorCommand}"
                                        AutomationProperties.AutomationId="OpenGenerator">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AutoFix" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Nav.Generator}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Security"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Security}"
                                             AutomationProperties.AutomationId="OpenSecurityCenter">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldCheck" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Nav.SecurityCenter}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <Button Style="{StaticResource NavItemButton}"
                                        Command="{Binding DataContext.Backup.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.AutomationId="OpenBackup">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BackupRestore" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Nav.Backup}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <RadioButton GroupName="Nav" Style="{StaticResource NavRadioButtonItem}"
                                             Command="{Binding SetSectionCommand}" CommandParameter="Trash"
                                             IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Trash}"
                                             AutomationProperties.AutomationId="NavTrash">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Nav.Trash}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <Button Style="{StaticResource NavItemButton}" Margin="8,12,8,10"
                                        Command="{Binding DataContext.Settings.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.AutomationId="NavSettings">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Nav.Settings}" Margin="10,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ══ Center list (spans the details column while Security Center is active) ══ -->
                    <Border Grid.Column="1" Margin="10,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SecuritySectionActive}" Value="True">
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header: contextual title / search / sort / new -->
                            <Border Grid.Row="0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                                    Padding="16,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding ListHeader}" Style="{StaticResource SubtitleText}"
                                               FontSize="16" Margin="0,2,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Search with watermark -->
                                        <Border Background="{DynamicResource Bg.Sunken}" CornerRadius="8" Padding="10,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"
                                                                         Foreground="{DynamicResource Text.Secondary}"
                                                                         VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Style="{StaticResource SearchBoxStyle}" BorderThickness="0"
                                                         Background="Transparent" MinWidth="160" Margin="8,0"
                                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                                         AutomationProperties.AutomationId="SearchBox" />
                                                <TextBlock Grid.Column="1" Text="{loc:Loc Search.Placeholder}"
                                                           IsHitTestVisible="False" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}" />
                                            </Grid>
                                        </Border>
                                        <ComboBox Grid.Column="1" Width="150" Margin="10,0" VerticalAlignment="Center"
                                                  SelectedValue="{Binding SortBy}" SelectedValuePath="Tag"
                                                  AutomationProperties.Name="{loc:Loc Sort.Label}">
                                            <ComboBoxItem Tag="updated" Content="{loc:Loc Sort.Updated}" />
                                            <ComboBoxItem Tag="title" Content="{loc:Loc Sort.Title}" />
                                            <ComboBoxItem Tag="created" Content="{loc:Loc Sort.Created}" />
                                        </ComboBox>
                                        <Button Grid.Column="2" Command="{Binding BeginCreateCommand}" Margin="10,0"
                                                AutomationProperties.AutomationId="AddCredential" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc Center.NewItem}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1">
                                <!-- Security Center dashboard -->
                                <StackPanel Margin="16"
                                            Visibility="{Binding SecuritySectionActive, Converter={StaticResource BoolToVisible}}"
                                            AutomationProperties.AutomationId="SecurityCenter">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Loc Security.Score}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SecurityScoreText}" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}" Margin="8,0"
                                                   AutomationProperties.AutomationId="SecurityScore" />
                                        <Button Content="{loc:Loc Security.Refresh}" Style="{StaticResource IconButton}"
                                                Command="{Binding RunSecurityAnalysisCommand}" Margin="16,0,0,0"
                                                AutomationProperties.AutomationId="SecurityRefresh" />
                                        <TextBlock Text="{loc:Loc Security.Working}" Style="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="{Binding SecurityAnalysisBusy, Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc Security.OfflineNote}" Style="{StaticResource SecondaryText}"
                                               Margin="0,4,0,0" />
                                    <ProgressBar Height="6" Minimum="0" Maximum="100" Margin="0,12,0,0"
                                                 Value="{Binding SecurityReport.Score, Mode=OneWay}" />

                                    <!-- Finding-kind chips: count + label; they double as filters -->
                                    <WrapPanel Margin="0,14,0,0">
                                        <RadioButton GroupName="Findings" Style="{StaticResource FilterChip}"
                                                     IsChecked="True"
                                                     Command="{Binding FilterFindingsCommand}">
                                            <TextBlock Text="{loc:Loc Security.AllFindings}" />
                                        </RadioButton>
                                        <RadioButton GroupName="Findings" Style="{StaticResource FilterChip}"
                                                     Command="{Binding FilterFindingsCommand}" CommandParameter="WeakPassword">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding WeakCount}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Loc Findings.WeakPassword}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Findings" Style="{StaticResource FilterChip}"
                                                     Command="{Binding FilterFindingsCommand}" CommandParameter="ReusedPassword">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ReusedCount}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Loc Findings.ReusedPassword}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Findings" Style="{StaticResource FilterChip}"
                                                     Command="{Binding FilterFindingsCommand}" CommandParameter="EmptyPassword">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding EmptyCount}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Loc Findings.EmptyPassword}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Findings" Style="{StaticResource FilterChip}"
                                                     Command="{Binding FilterFindingsCommand}" CommandParameter="OldPassword">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OldCount}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Loc Findings.OldPassword}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Findings" Style="{StaticResource FilterChip}"
                                                     Command="{Binding FilterFindingsCommand}" CommandParameter="MissingAuthenticator">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding MissingAuthenticatorCount}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Loc Findings.MissingAuthenticator}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Findings" Style="{StaticResource FilterChip}"
                                                     Command="{Binding FilterFindingsCommand}" CommandParameter="DuplicateAccount">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DuplicateCount}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Loc Findings.DuplicateAccount}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Findings" Style="{StaticResource FilterChip}"
                                                     Command="{Binding FilterFindingsCommand}" CommandParameter="ExpiringSecret">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ExpiringCount}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Loc Findings.ExpiringSecret}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </WrapPanel>

                                    <ListBox ItemsSource="{Binding FindingsView}" MinHeight="120"
                                             Background="Transparent" BorderThickness="0" Margin="0,12,0,0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.AutomationId="FindingsList">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                                        Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.OpenFindingItemCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <materialDesign:PackIcon Kind="AlertOutline" Width="18" Height="18"
                                                                                 Foreground="{DynamicResource Warning}"
                                                                                 VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Margin="10,0" HorizontalAlignment="Stretch">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Kind, Converter={StaticResource FindingKindLabel}}"
                                                                           FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ItemTitle}" FontSize="13" Margin="10,0"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DetailKey, Converter={StaticResource FindingDetail}}"
                                                                       FontSize="11" Foreground="{DynamicResource Text.Secondary}"
                                                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{loc:Loc Security.NoFindings}" Style="{StaticResource SecondaryText}"
                                               HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <TextBlock.Visibility>
                                            <Binding Path="FindingsView.Count" Converter="{StaticResource ZeroToVisible}" />
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Normal item list -->
                                <Grid Visibility="{Binding SecuritySectionActive, Converter={StaticResource FalseToVisible}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <ListBox ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedCredential}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 AutomationProperties.AutomationId="CredentialList">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="12,9" AutomationProperties.AutomationId="CredentialRow">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="34" Height="34" CornerRadius="8"
                                                                Background="{DynamicResource Accent.Soft}">
                                                            <materialDesign:PackIcon Width="18" Height="18"
                                                                                     Foreground="{DynamicResource Accent}"
                                                                                     Kind="{Binding Kind, Converter={StaticResource TypeToIcon}}"
                                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                                                       Foreground="{DynamicResource Text.Primary}" TextTrimming="CharacterEllipsis"
                                                                       AutomationProperties.AutomationId="RowTitle" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                                       Foreground="{DynamicResource Text.Secondary}" Margin="0,1,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       AutomationProperties.AutomationId="RowUsername" />
                                                        </StackPanel>
                                                        <materialDesign:PackIcon Grid.Column="2" Kind="Star" Width="14" Height="14"
                                                                                 Foreground="{DynamicResource Warning}"
                                                                                 VerticalAlignment="Center"
                                                                                 Visibility="{Binding Favorite, Converter={StaticResource BoolToVisible}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding RowsView.Count, Converter={StaticResource ZeroToVisible}}"
                                                    AutomationProperties.AutomationId="CenterEmpty">
                                            <materialDesign:PackIcon Kind="ShieldOff" Width="48" Height="48"
                                                                     Foreground="{DynamicResource Text.Secondary}"
                                                                     HorizontalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc Center.EmptyTitle}" Style="{StaticResource TitleText}"
                                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                                            <TextBlock Text="{loc:Loc Center.EmptyText}" Style="{StaticResource SecondaryText}"
                                                       HorizontalAlignment="Center" Margin="0,8,0,0"
                                                       MaxWidth="260" TextWrapping="Wrap" TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ══ Details ══ -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}"
                            AutomationProperties.AutomationId="DetailsPane"
                            Visibility="{Binding SecuritySectionActive, Converter={StaticResource FalseToVisible}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Empty state -->
                            <StackPanel Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding Detail, Converter={StaticResource NullToVisible}}">
                                <materialDesign:PackIcon Kind="ShieldKey" Width="44" Height="44"
                                                         Foreground="{DynamicResource Text.Secondary}"
                                                         HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Details.PlaceholderTitle}" Style="{StaticResource TitleText}"
                                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="{loc:Loc Details.PlaceholderText}" Style="{StaticResource SecondaryText}"
                                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"
                                           MaxWidth="260" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Header (item identity) -->
                            <Grid Grid.Row="0" Margin="20,16,20,8"
                                  Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10"
                                        Background="{DynamicResource Accent.Soft}" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Width="22" Height="22"
                                                             Foreground="{DynamicResource Accent}"
                                                             Kind="{Binding Detail.Kind, Converter={StaticResource TypeToIcon}}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Detail.Title}" Style="{StaticResource SubtitleText}" FontSize="18"
                                               TextWrapping="Wrap" AutomationProperties.AutomationId="DetailTitle" />
                                    <TextBlock Text="{Binding DetailUsernameText}" Style="{StaticResource SecondaryText}"
                                               FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               AutomationProperties.AutomationId="DetailUsername" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconActionButton}" VerticalAlignment="Center"
                                        Command="{Binding ToggleFavoriteCommand}"
                                        ToolTip="{loc:Loc Details.Favorite}"
                                        AutomationProperties.Name="{loc:Loc Details.Favorite}"
                                        AutomationProperties.AutomationId="ToggleFavorite">
                                    <materialDesign:PackIcon Width="18" Height="18">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="StarOutline" />
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetailIsFavorite}" Value="True">
                                                        <Setter Property="Kind" Value="Star" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Button>
                            </Grid>

                            <!-- Scrollable field groups -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}">
                                <StackPanel Margin="20,4,20,12">

                                    <!-- Login credentials -->
                                    <Border Style="{StaticResource SectionCard}"
                                            Visibility="{Binding IsLoginDetail, Converter={StaticResource BoolToVisible}}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc Details.Username}" Style="{StaticResource FieldLabel}" Margin="0" />
                                                <Button Grid.Column="1" Style="{StaticResource IconActionButton}"
                                                        Command="{Binding CopyUsernameCommand}"
                                                        ToolTip="{loc:Loc Details.CopyUsername}"
                                                        AutomationProperties.Name="{loc:Loc Details.CopyUsername}"
                                                        AutomationProperties.AutomationId="CopyUsername">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="{Binding DetailUsernameText}" Style="{StaticResource BodyText}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc Details.Password}" Style="{StaticResource FieldLabel}" Margin="0" />
                                                <Button Grid.Column="1" Style="{StaticResource IconActionButton}"
                                                        Command="{Binding ToggleRevealCommand}"
                                                        ToolTip="{loc:Loc Details.Reveal}"
                                                        AutomationProperties.Name="{loc:Loc Details.Reveal}"
                                                        AutomationProperties.AutomationId="RevealPassword">
                                                    <materialDesign:PackIcon Width="16" Height="16">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="Eye" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PasswordRevealed}" Value="True">
                                                                        <Setter Property="Kind" Value="EyeOff" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Button>
                                                <Button Grid.Column="2" Style="{StaticResource IconActionButton}"
                                                        Command="{Binding CopyPasswordCommand}"
                                                        ToolTip="{loc:Loc Details.CopyPassword}"
                                                        AutomationProperties.Name="{loc:Loc Details.CopyPassword}"
                                                        AutomationProperties.AutomationId="CopyPassword">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="{Binding PasswordDisplay}" Style="{StaticResource LtrValueText}"
                                                       Margin="0,2,0,0"
                                                       AutomationProperties.AutomationId="DetailPassword" />

                                            <StackPanel Visibility="{Binding DetailWebsiteText, Converter={StaticResource NullToCollapsed}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:Loc Details.Website}" Style="{StaticResource FieldLabel}" Margin="0" />
                                                    <Button Grid.Column="1" Style="{StaticResource IconActionButton}"
                                                            Command="{Binding OpenWebsiteCommand}"
                                                            ToolTip="{loc:Loc Details.OpenSite}"
                                                            AutomationProperties.Name="{loc:Loc Details.OpenSite}">
                                                        <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="{Binding DetailWebsiteText}" Style="{StaticResource LtrValueText}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- TOTP -->
                                    <Border Style="{StaticResource SectionCard}"
                                            Visibility="{Binding TotpAvailable, Converter={StaticResource BoolToVisible}}"
                                            AutomationProperties.AutomationId="TotpSection">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc Totp.Title}" Style="{StaticResource FieldLabel}" Margin="0" />
                                                <Button Grid.Column="1" Style="{StaticResource IconActionButton}"
                                                        Command="{Binding CopyTotpCommand}"
                                                        ToolTip="{loc:Loc Totp.Copy}"
                                                        AutomationProperties.Name="{loc:Loc Totp.Copy}"
                                                        AutomationProperties.AutomationId="CopyTotp">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
                                                </Button>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding TotpCode}" FontSize="22" FontWeight="SemiBold"
                                                           Style="{StaticResource LtrValueText}"
                                                           AutomationProperties.AutomationId="TotpCode" />
                                                <TextBlock Margin="10,0" VerticalAlignment="Center"
                                                           AutomationProperties.AutomationId="TotpSeconds"
                                                           Style="{StaticResource SecondaryText}">
                                                    <Run Text="{Binding TotpSecondsRemaining, Mode=OneWay}" />
                                                    <Run Text="{loc:Loc Totp.Seconds}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{loc:Loc Totp.FactorWarning}" Style="{StaticResource SecondaryText}"
                                                       TextWrapping="Wrap" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Type-specific fields (non-login) -->
                                    <Border Style="{StaticResource SectionCard}"
                                            Visibility="{Binding IsGenericDetail, Converter={StaticResource BoolToVisible}}">
                                        <ItemsControl ItemsSource="{Binding DetailDataRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,8,0,2">
                                                        <Grid Visibility="{Binding Masked, Converter={StaticResource BoolToVisible}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Style="{StaticResource IconActionButton}"
                                                                    Command="{Binding DataContext.RevealFieldRowCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:Loc Details.Reveal}">
                                                                <materialDesign:PackIcon Kind="Eye" Width="16" Height="16" />
                                                            </Button>
                                                            <Button Grid.Column="2" Style="{StaticResource IconActionButton}"
                                                                    Command="{Binding DataContext.CopyFieldRowCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:Loc Editor.Copy}">
                                                                <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
                                                            </Button>
                                                        </Grid>
                                                        <Grid Visibility="{Binding Masked, Converter={StaticResource FalseToVisible}}">
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Margin="0" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Display}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Masked}" Value="True">
                                                                            <Setter Property="FontFamily" Value="Consolas" />
                                                                            <Setter Property="FlowDirection" Value="LeftToRight" />
                                                                            <Setter Property="TextAlignment" Value="Left" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- Custom fields -->
                                    <Border Style="{StaticResource SectionCard}"
                                            Visibility="{Binding DetailCustomRows.Count, Converter={StaticResource ZeroToCollapsed}}">
                                        <ItemsControl ItemsSource="{Binding DetailCustomRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,8,0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Style="{StaticResource IconActionButton}"
                                                                    Command="{Binding DataContext.CopyFieldRowCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:Loc Editor.Copy}">
                                                                <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" />
                                                            </Button>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Display}" Style="{StaticResource BodyText}"
                                                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- Notes / description -->
                                    <Border Style="{StaticResource SectionCard}"
                                            Visibility="{Binding DetailNotesText, Converter={StaticResource NullToCollapsed}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Details.Notes}" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <TextBlock Text="{Binding DetailNotesText}" Style="{StaticResource BodyText}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Attachments (all item kinds) -->
                                    <Border Style="{StaticResource SectionCard}"
                                            Visibility="{Binding Attachments.Count, Converter={StaticResource ZeroToCollapsed}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Attachments.Title}" Style="{StaticResource FieldLabel}" Margin="0" />
                                            <ItemsControl ItemsSource="{Binding Attachments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Filename}" Style="{StaticResource BodyText}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Style="{StaticResource IconActionButton}"
                                                                    Click="OnExportAttachmentClick"
                                                                    Command="{Binding DataContext.BeginExportAttachmentCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    ToolTip="{loc:Loc Attachments.Export}">
                                                                <materialDesign:PackIcon Kind="Download" Width="16" Height="16" />
                                                            </Button>
                                                            <Button Grid.Column="2" Style="{StaticResource IconActionButton}"
                                                                    Command="{Binding DataContext.DeleteAttachmentCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    ToolTip="{loc:Loc Details.Delete}">
                                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Style="{StaticResource IconButton}" Margin="0,6,0,0"
                                                    Click="OnAddAttachmentClick"
                                                    AutomationProperties.AutomationId="AddAttachment">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Paperclip" Width="16" Height="16" VerticalAlignment="Center" />
                                                    <TextBlock Text="{loc:Loc Attachments.Add}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <!-- Attachment add affordance when the card is hidden (empty list) -->
                                    <Button Style="{StaticResource IconButton}" 
                                            Visibility="{Binding Attachments.Count, Converter={StaticResource ZeroToVisible}}"
                                            Click="OnAddAttachmentClick">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Paperclip" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc Attachments.Add}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- History (auto-loaded; restore needs a selected version) -->
                                    <Border Style="{StaticResource SectionCard}"
                                            Visibility="{Binding Versions.Count, Converter={StaticResource ZeroToCollapsed}}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc History.Title}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="{loc:Loc History.Restore}" Style="{StaticResource IconButton}"
                                                        Command="{Binding RestoreVersionCommand}"
                                                        IsEnabled="{Binding SelectedVersion, Converter={StaticResource NullToBool}}"
                                                        AutomationProperties.AutomationId="RestoreVersion" />
                                            </Grid>
                                            <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                                                     Background="Transparent" BorderThickness="0" MinHeight="26" MaxHeight="130"
                                                     Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     AutomationProperties.AutomationId="VersionList">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="6,3" Style="{StaticResource BodyText}">
                                                            <Run Text="v" />
                                                            <Run Text="{Binding Version, Mode=OneWay}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding CreatedAt, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Margin="0,4,0,10" Style="{StaticResource SecondaryText}"
                                               AutomationProperties.AutomationId="DetailDates">
                                        <Run Text="{loc:Loc Details.Created}" />
                                        <Run Text="{Binding Detail.CreatedAt, Mode=OneWay}" />
                                        <Run Text="   |   " />
                                        <Run Text="{loc:Loc Details.Modified}" />
                                        <Run Text="{Binding Detail.UpdatedAt, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Footer actions (pinned) -->
                            <Grid Grid.Row="2" Margin="20,10,20,14"
                                  Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding TrashView, Converter={StaticResource FalseToVisible}}">
                                    <Button Content="{loc:Loc Details.Edit}" Command="{Binding BeginEditCommand}"
                                            Margin="8,0" AutomationProperties.AutomationId="EditCredential" />
                                    <Button Content="{loc:Loc Details.Delete}" Command="{Binding BeginDeleteCommand}"
                                            Style="{StaticResource DangerButton}"
                                            AutomationProperties.AutomationId="DeleteCredential" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding TrashView, Converter={StaticResource BoolToVisible}}">
                                    <Button Content="{loc:Loc Trash.Restore}" Command="{Binding RestoreFromTrashCommand}"
                                            Margin="8,0" AutomationProperties.AutomationId="RestoreFromTrash" />
                                    <Button Content="{loc:Loc Trash.Purge}" Command="{Binding BeginPurgeFromTrashCommand}"
                                            Style="{StaticResource DangerButton}" Margin="8,0"
                                            AutomationProperties.AutomationId="PurgeFromTrash" />
                                    <Button Content="{loc:Loc Trash.Empty}" Style="{StaticResource IconButton}"
                                            Command="{Binding BeginEmptyTrashCommand}"
                                            AutomationProperties.AutomationId="EmptyTrash" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Status bar -->
                <Border Grid.Row="2" Background="{DynamicResource Bg.Sunken}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryText}" Margin="16,0"
                               VerticalAlignment="Center" AutomationProperties.AutomationId="StatusText" />
                </Border>

                <!-- Editor overlay -->
                <Grid Grid.RowSpan="3" Background="{DynamicResource Overlay.Scrim}"
                      Visibility="{Binding EditorVisible, Converter={StaticResource BoolToVisible}}">
                    <Border MaxWidth="620" MinWidth="540" Style="{StaticResource CardBorder}" Margin="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="EditorPane">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Editor header -->
                            <Grid Grid.Row="0" Margin="24,16,16,4">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Accent.Soft}">
                                        <materialDesign:PackIcon Width="18" Height="18" Foreground="{DynamicResource Accent}"
                                                                 Kind="{Binding EditorKind, Converter={StaticResource TypeToIcon}}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Margin="10,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TitleText}">
                                                <Setter Property="Text" Value="{loc:Loc Editor.NewItemTitle}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditingId, Converter={StaticResource NullToBool}}" Value="True">
                                                        <Setter Property="Text" Value="{loc:Loc Editor.EditItemTitle}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button Style="{StaticResource IconActionButton}" HorizontalAlignment="Right"
                                        Command="{Binding CancelEditorCommand}"
                                        ToolTip="{loc:Loc Editor.Cancel}">
                                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                                </Button>
                            </Grid>

                            <!-- Editor body -->
                            <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto"
                                          Margin="24,4,24,0">
                                <StackPanel>
                                    <!-- Type picker: create mode only -->
                                    <StackPanel Visibility="{Binding EditingId, Converter={StaticResource NullToVisible}}">
                                        <TextBlock Text="{loc:Loc Editor.Type}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding EditorKindChoices}" SelectedItem="{Binding EditorKind}"
                                                  Margin="0,0,0,6"
                                                  ItemTemplate="{StaticResource ItemTypeComboTemplate}" />
                                    </StackPanel>

                                    <!-- Login fields -->
                                    <StackPanel Visibility="{Binding EditorIsLogin, Converter={StaticResource BoolToVisible}}">
                                        <TextBlock Text="{loc:Loc Details.Title}" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                                        <TextBox Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SearchBoxStyle}" Margin="0,4,0,10" MaxLength="200"
                                                 AutomationProperties.AutomationId="EditorTitle" />
                                        <TextBlock Text="{loc:Loc Details.Username}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding EditorUsername, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SearchBoxStyle}" Margin="0,4,0,10" MaxLength="320"
                                                 AutomationProperties.AutomationId="EditorUsername" />
                                        <TextBlock Text="{loc:Loc Details.Password}" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox x:Name="EditorPassword" Margin="0,4,0,2" Style="{StaticResource PasswordBoxStyle}"
                                                     MaxLength="1000" AutomationProperties.AutomationId="EditorPassword" />
                                        <TextBlock Text="{loc:Loc Editor.PasswordKeep}" Style="{StaticResource SecondaryText}"
                                                   Margin="0,0,0,10"
                                                   Visibility="{Binding EditingId, Converter={StaticResource NullToCollapsed}}" />
                                        <TextBlock Text="{loc:Loc Details.Website}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding EditorWebsiteUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SearchBoxStyle}" Margin="0,4,0,10" MaxLength="2048"
                                                 AutomationProperties.AutomationId="EditorWebsite" />
                                        <TextBlock Text="{loc:Loc Details.Notes}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding EditorNotes, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SearchBoxStyle}" Margin="0,4,0,4" MaxLength="10000"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalScrollBarVisibility="Auto"
                                                 AutomationProperties.AutomationId="EditorNotes" />
                                    </StackPanel>

                                    <!-- Type-specific dynamic rows (non-login) -->
                                    <ItemsControl ItemsSource="{Binding EditorDataFields}" Margin="0,2,0,4"
                                                  Visibility="{Binding EditorIsLogin, Converter={StaticResource FalseToVisible}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,8,0,6">
                                                    <TextBlock Text="{Binding LabelKey, Converter={StaticResource LocKey}}"
                                                               Style="{StaticResource FieldLabel}" Margin="0" />
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource SearchBoxStyle}" Margin="0,4,0,0" MaxLength="2000"
                                                             Visibility="{Binding IsSingleLine, Converter={StaticResource BoolToVisible}}" />
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource SearchBoxStyle}" Margin="0,4,0,0" MinHeight="60"
                                                             AcceptsReturn="True" TextWrapping="Wrap"
                                                             Visibility="{Binding IsMultiline, Converter={StaticResource BoolToVisible}}" />
                                                    <CheckBox Content="{Binding DataKey}" IsChecked="{Binding BooleanValue}"
                                                              Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisible}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{loc:Loc Editor.Description}" Style="{StaticResource FieldLabel}"
                                               Visibility="{Binding EditorIsLogin, Converter={StaticResource FalseToVisible}}" />
                                    <TextBox Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchBoxStyle}" Margin="0,4,0,10" MaxLength="2000"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"
                                             Visibility="{Binding EditorIsLogin, Converter={StaticResource FalseToVisible}}" />

                                    <!-- Custom fields -->
                                    <TextBlock Text="{loc:Loc Editor.CustomFields}" Style="{StaticResource FieldLabel}" Margin="0,8,0,2" />
                                    <ItemsControl ItemsSource="{Binding EditorCustomFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource SearchBoxStyle}" Margin="4,0" MaxLength="100" />
                                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding TypeIndex}" Margin="4,0"
                                                              VerticalAlignment="Center"
                                                              ItemsSource="{x:Static vm:CustomFieldEditorViewModel.CustomFieldTypeValues}" />
                                                    <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource SearchBoxStyle}" Margin="4,0" MaxLength="5000" />
                                                    <CheckBox Grid.Column="3" IsChecked="{Binding Concealed}" VerticalAlignment="Center"
                                                              Margin="4,0" ToolTip="{loc:Loc Details.Hide}" />
                                                    <Button Grid.Column="4" Style="{StaticResource IconActionButton}"
                                                            Command="{Binding DataContext.RemoveCustomFieldCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Margin="4,0" VerticalAlignment="Center"
                                                            ToolTip="{loc:Loc Editor.Remove}">
                                                        <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Stretch"
                                            Command="{Binding AddCustomFieldCommand}" Margin="0,4,0,4"
                                            AutomationProperties.AutomationId="AddCustomField">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc Editor.AddField}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Organization: folder + tags -->
                                    <TextBlock Text="{loc:Loc Editor.Folder}" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                                    <ComboBox ItemsSource="{Binding FolderNav}" SelectedValue="{Binding EditorFolderId}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,0,0,6" />
                                    <TextBlock Text="{loc:Loc Editor.Tags}" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
                                    <TextBox Text="{Binding EditorTagNames, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchBoxStyle}" Margin="0,0,0,4" MaxLength="500"
                                             AutomationProperties.AutomationId="EditorTags" />
                                    <TextBlock Text="{Binding EditorError}" Foreground="{DynamicResource Danger}"
                                               Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Editor footer -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,18">
                                <Button Content="{loc:Loc Editor.Cancel}" Style="{StaticResource IconButton}"
                                        Command="{Binding CancelEditorCommand}" Margin="8,0"
                                        AutomationProperties.AutomationId="EditorCancel" />
                                <Button Content="{loc:Loc Editor.Save}" Command="{Binding SaveEditorCommand}"
                                        IsDefault="True" Click="OnEditorSaveClick"
                                        AutomationProperties.AutomationId="EditorSave" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Generator overlay -->
                <Grid Grid.RowSpan="3" Background="{DynamicResource Overlay.Scrim}"
                      Visibility="{Binding GeneratorVisible, Converter={StaticResource BoolToVisible}}">
                    <Border MaxWidth="620" Style="{StaticResource CardBorder}" Margin="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="GeneratorPane">
                        <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,20,24,16">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Accent.Soft}">
                                        <materialDesign:PackIcon Kind="AutoFix" Width="18" Height="18"
                                                                 Foreground="{DynamicResource Accent}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{loc:Loc Nav.Generator}" Style="{StaticResource TitleText}"
                                               Margin="10,0" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="GeneratorTitle" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                                    <RadioButton Content="{loc:Loc Generator.Password}" IsChecked="{Binding PassphraseMode, Converter={StaticResource FalseToVisible}}"
                                                 GroupName="GenMode" Margin="0,0,16,0" />
                                    <RadioButton Content="{loc:Loc Generator.Passphrase}" IsChecked="{Binding PassphraseMode}"
                                                 GroupName="GenMode" />
                                </StackPanel>

                                <!-- Character mode -->
                                <StackPanel Visibility="{Binding PassphraseMode, Converter={StaticResource FalseToVisible}}">
                                    <Border Style="{StaticResource CardBorder}" Background="{DynamicResource Bg.Sunken}" Padding="12" Margin="0,8,0,0">
                                        <TextBlock AutomationProperties.AutomationId="GeneratorOutput"
                                                   Text="{Binding GeneratedPassword}" FontSize="16" FontWeight="SemiBold"
                                                   Style="{StaticResource LtrValueText}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                                        <Run Text="{Binding GeneratorEntropyText, Mode=OneWay}" />
                                        <Run Text="bit" />
                                    </TextBlock>

                                    <!-- Presets -->
                                    <WrapPanel Margin="0,10,0,0">
                                        <RadioButton GroupName="Presets" Style="{StaticResource FilterChip}"
                                                     Command="{Binding ApplyPresetCommand}" CommandParameter="Standard"
                                                     Content="{loc:Loc Generator.Preset.Standard}" />
                                        <RadioButton GroupName="Presets" Style="{StaticResource FilterChip}"
                                                     Command="{Binding ApplyPresetCommand}" CommandParameter="Strong"
                                                     Content="{loc:Loc Generator.Preset.Strong}" />
                                        <RadioButton GroupName="Presets" Style="{StaticResource FilterChip}"
                                                     Command="{Binding ApplyPresetCommand}" CommandParameter="MaximumCompatibility"
                                                     Content="{loc:Loc Generator.Preset.Compat}" />
                                        <RadioButton GroupName="Presets" Style="{StaticResource FilterChip}"
                                                     Command="{Binding ApplyPresetCommand}" CommandParameter="NumericPin"
                                                     Content="{loc:Loc Generator.Preset.Pin}" />
                                    </WrapPanel>

                                    <TextBlock Text="{loc:Loc Generator.Length}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                    <Slider Minimum="8" Maximum="64" Value="{Binding GeneratorLength}"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            AutomationProperties.AutomationId="GeneratorLength" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <CheckBox Content="a-z" IsChecked="{Binding GenLowercase}" Margin="0,0,12,0" />
                                        <CheckBox Content="A-Z" IsChecked="{Binding GenUppercase}" Margin="0,0,12,0" />
                                        <CheckBox Content="0-9" IsChecked="{Binding GenDigits}" Margin="0,0,12,0" />
                                        <CheckBox Content="!@#" IsChecked="{Binding GenSymbols}" Margin="0,0,12,0" />
                                        <CheckBox Content="{loc:Loc Generator.NoAmbiguous}" IsChecked="{Binding GenExcludeAmbiguous}" />
                                    </WrapPanel>
                                    <TextBlock Text="{loc:Loc Generator.Excluded}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding GenExcludedCharacters, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchBoxStyle}" Margin="0,4,0,0" MaxLength="100"
                                             AutomationProperties.AutomationId="GeneratorExcluded" />
                                </StackPanel>

                                <!-- Passphrase mode -->
                                <StackPanel Visibility="{Binding PassphraseMode, Converter={StaticResource BoolToVisible}}">
                                    <Border Style="{StaticResource CardBorder}" Background="{DynamicResource Bg.Sunken}" Padding="12" Margin="0,8,0,0">
                                        <TextBlock AutomationProperties.AutomationId="PassphraseOutput"
                                                   Text="{Binding GeneratedPassphrase}" FontSize="16" FontWeight="SemiBold"
                                                   Style="{StaticResource LtrValueText}" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                                        <Run Text="{Binding PassphraseEntropyText, Mode=OneWay}" />
                                        <Run Text="bit" />
                                    </TextBlock>
                                    <TextBlock Text="{loc:Loc Generator.Words}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                    <Slider Minimum="3" Maximum="12" Value="{Binding PassphraseWordCount}"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            AutomationProperties.AutomationId="PassphraseWords" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{loc:Loc Generator.Separator}" Style="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                        <TextBox Text="{Binding PassphraseSeparator, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SearchBoxStyle}" MaxLength="3" Width="80"
                                                 AutomationProperties.AutomationId="PassphraseSeparator" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox Content="{loc:Loc Generator.Capitalize}" IsChecked="{Binding PassphraseCapitalize}"
                                                  Margin="0,0,16,0" />
                                        <CheckBox Content="{loc:Loc Generator.NumberSuffix}" IsChecked="{Binding PassphraseNumber}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="{Binding GeneratorStrengthText}" Foreground="{DynamicResource Warning}"
                                           Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Content="{loc:Loc Generator.Regenerate}" Style="{StaticResource IconButton}"
                                            Command="{Binding GenerateNowCommand}" Margin="8,0"
                                            AutomationProperties.AutomationId="Regenerate" />
                                    <Button Content="{loc:Loc Details.CopyPassword}" Style="{StaticResource IconButton}"
                                            Command="{Binding CopyGeneratedPasswordCommand}" Margin="10,0"
                                            AutomationProperties.AutomationId="CopyGenerated" />
                                    <Button Content="{loc:Loc Generator.UseInEditor}" Command="{Binding UseInEditorCommand}"
                                            Margin="10,0"
                                            AutomationProperties.AutomationId="UseInEditor"
                                            Visibility="{Binding GeneratorTargetIsEditor, Converter={StaticResource BoolToVisible}}" />
                                    <Button Content="{loc:Loc Picker.Cancel}" Style="{StaticResource IconButton}"
                                            Command="{Binding CloseGeneratorCommand}" Margin="10,0"
                                            AutomationProperties.AutomationId="CloseGenerator" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Delete confirmation overlay -->
                <Grid Grid.RowSpan="3" Background="{DynamicResource Overlay.Scrim}"
                      Visibility="{Binding DeleteConfirmVisible, Converter={StaticResource BoolToVisible}}">
                    <Border MaxWidth="440" Style="{StaticResource CardBorder}" Padding="24" Margin="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="DeleteConfirmPane">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertOutline" Width="24" Height="24"
                                                         Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Confirm.DeleteTitle}" Style="{StaticResource TitleText}"
                                           Margin="10,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,0">
                                <Run Text="{loc:Loc Confirm.DeleteText}" />
                                <Run Text="{Binding SelectedCredential.Title, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                <Button Content="{loc:Loc Picker.Cancel}" Style="{StaticResource IconButton}"
                                        Command="{Binding CancelDeleteCommand}" Margin="8,0"
                                        AutomationProperties.AutomationId="DeleteCancel" />
                                <Button Content="{loc:Loc Picker.Yes}" Command="{Binding ConfirmDeleteCommand}"
                                        Style="{StaticResource DangerButton}"
                                        AutomationProperties.AutomationId="DeleteConfirm" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Empty-trash confirmation overlay -->
                <Grid Grid.RowSpan="3" Background="{DynamicResource Overlay.Scrim}"
                      Visibility="{Binding EmptyTrashConfirmVisible, Converter={StaticResource BoolToVisible}}">
                    <Border MaxWidth="440" Style="{StaticResource CardBorder}" Padding="24" Margin="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="EmptyTrashConfirmPane">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="24" Height="24"
                                                         Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Confirm.EmptyTrashTitle}" Style="{StaticResource TitleText}"
                                           Margin="10,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{loc:Loc Confirm.EmptyTrashText}" Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                <Button Content="{loc:Loc Picker.Cancel}" Style="{StaticResource IconButton}"
                                        Command="{Binding CancelEmptyTrashCommand}" Margin="8,0"
                                        AutomationProperties.AutomationId="EmptyTrashCancel" />
                                <Button Content="{loc:Loc Trash.Empty}" Command="{Binding ConfirmEmptyTrashCommand}"
                                        Style="{StaticResource DangerButton}"
                                        AutomationProperties.AutomationId="EmptyTrashConfirm" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentView}" Focusable="False" />

        <!-- ═══════════════ Settings overlay (app-level) ═══════════════ -->
        <Grid Background="{DynamicResource Overlay.Scrim}"
              Visibility="{Binding Settings.IsVisible, Converter={StaticResource BoolToVisible}}">
            <Border MaxWidth="480" Style="{StaticResource CardBorder}" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SettingsPane">
                <StackPanel Margin="24,20">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Accent.Soft}">
                                <materialDesign:PackIcon Kind="Cog" Width="18" Height="18"
                                                         Foreground="{DynamicResource Accent}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:Loc Nav.Settings}" Style="{StaticResource TitleText}"
                                       Margin="10,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource IconActionButton}" HorizontalAlignment="Right"
                                Command="{Binding Settings.CloseCommand}" ToolTip="{loc:Loc Picker.Cancel}"
                                AutomationProperties.AutomationId="SettingsCloseButton">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                    </Grid>

                    <TextBlock Text="{loc:Loc Settings.Language}" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="SettingsLanguage" Content="فارسی" Margin="0,0,16,0"
                                     IsChecked="{Binding Settings.LanguageIndex, Converter={StaticResource IndexEquals}, ConverterParameter=0}" />
                        <RadioButton GroupName="SettingsLanguage" Content="English"
                                     IsChecked="{Binding Settings.LanguageIndex, Converter={StaticResource IndexEquals}, ConverterParameter=1}" />
                    </StackPanel>

                    <TextBlock Text="{loc:Loc Settings.Theme}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="SettingsTheme" Content="{loc:Loc Menu.Theme.Light}" Margin="0,0,16,0"
                                     IsChecked="{Binding Settings.ThemeIndex, Converter={StaticResource IndexEquals}, ConverterParameter=0}" />
                        <RadioButton GroupName="SettingsTheme" Content="{loc:Loc Menu.Theme.Dark}"
                                     IsChecked="{Binding Settings.ThemeIndex, Converter={StaticResource IndexEquals}, ConverterParameter=1}" />
                    </StackPanel>

                    <TextBlock Text="{loc:Loc Settings.Clipboard}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="240" Minimum="10" Maximum="120" IsSnapToTickEnabled="True" TickFrequency="5"
                                Value="{Binding Settings.ClipboardSeconds}" VerticalAlignment="Center" />
                        <TextBlock Margin="10,0" VerticalAlignment="Center" Style="{StaticResource BodyText}">
                            <Run Text="{Binding Settings.ClipboardSeconds, Mode=OneWay}" />
                            <Run Text="{loc:Loc Settings.Seconds}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Settings.ClipboardHint}" Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />

                    <TextBlock Text="{loc:Loc Settings.AutoLock}" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding Settings.AutoLockValues}" SelectedIndex="{Binding Settings.AutoLockIndex}"
                                  Width="200">
                            <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="0">
                                                    <Setter Property="Text" Value="{loc:Loc Settings.AutoLockNever}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════ Backup &amp; restore overlay (app-level) ═══════════════ -->
        <Grid Background="{DynamicResource Overlay.Scrim}"
              Visibility="{Binding Backup.IsVisible, Converter={StaticResource BoolToVisible}}">
            <Border MaxWidth="520" MinWidth="480" Style="{StaticResource CardBorder}" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BackupPane">
                <StackPanel Margin="24,20">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Accent.Soft}">
                                <materialDesign:PackIcon Kind="BackupRestore" Width="18" Height="18"
                                                         Foreground="{DynamicResource Accent}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:Loc Nav.Backup}" Style="{StaticResource TitleText}"
                                       Margin="10,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource IconActionButton}" HorizontalAlignment="Right"
                                Command="{Binding Backup.CloseCommand}" ToolTip="{loc:Loc Picker.Cancel}"
                                AutomationProperties.AutomationId="BackupCloseButton">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                    </Grid>

                    <ProgressBar Height="4" IsIndeterminate="True" Margin="0,12,0,0"
                                 Visibility="{Binding Backup.IsBusy, Converter={StaticResource BoolToVisible}}" />

                    <!-- Menu stage -->
                    <StackPanel Visibility="{Binding Backup.RestoreStage, Converter={StaticResource FalseToVisible}}">
                        <Button Style="{StaticResource NavItemButton}" Margin="0,12,0,0"
                                Command="{Binding Backup.BeginCreateBackupCommand}"
                                AutomationProperties.AutomationId="BackupCreate">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Backup.CreateTitle}" Margin="10,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavItemButton}" Margin="0,4,0,0"
                                Command="{Binding Backup.BeginVerifyBackupCommand}"
                                AutomationProperties.AutomationId="BackupVerify">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Backup.VerifyTitle}" Margin="10,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavItemButton}" Margin="0,4,0,0"
                                Command="{Binding Backup.BeginRestoreCommand}"
                                AutomationProperties.AutomationId="BackupRestore">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Restore" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Backup.RestoreTitle}" Margin="10,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Restore stage -->
                    <StackPanel Visibility="{Binding Backup.RestoreStage, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{loc:Loc Backup.RestoreTitle}" Style="{StaticResource SubtitleText}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding Backup.RestorePathDisplay}" Style="{StaticResource SecondaryText}"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,4,0,8" />
                        <TextBlock Text="{loc:Loc Backup.RestoreDest}" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Backup.RestoreDestinationDisplay, Mode=OneWay}"
                                     Style="{StaticResource SearchBoxStyle}" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="{loc:Loc Backup.Browse}" Style="{StaticResource IconButton}"
                                    Command="{Binding Backup.PickRestoreDestinationCommand}" Margin="8,0,0,0"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{loc:Loc Backup.RestorePassword}" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="BackupRestorePassword" Margin="0,4,0,0" Style="{StaticResource PasswordBoxStyle}"
                                     MaxLength="1000" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="{loc:Loc Picker.Cancel}" Style="{StaticResource IconButton}"
                                    Command="{Binding Backup.CancelRestoreStageCommand}" Margin="8,0" />
                            <Button Content="{loc:Loc Backup.RestoreTitle}" Click="OnBackupRestoreConfirmClick"
                                    AutomationProperties.AutomationId="BackupRestoreConfirm" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding Backup.VerifySummary}" Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Backup.StatusMessage}" Foreground="{DynamicResource Accent}"
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"
                               AutomationProperties.AutomationId="BackupStatus" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
